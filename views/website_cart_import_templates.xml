<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone template for the upload block (injected via JavaScript) -->
    <template id="window_cart_upload_block" name="Window Cart Upload Block">
        <t t-if="not request.env.user._is_public()">
            <t t-set="partner" t-value="request.env.user.partner_id.commercial_partner_id"/>
            <t t-set="allow_upload"
                 t-value="partner and (partner.company_type == 'company' or partner.allow_window_schedule_upload)"/>
            <t t-if="allow_upload">
                <div class="window-cart-upload-block mt-3 mb-3" style="border: 1px solid #dee2e6; border-radius: 0.25rem; padding: 1rem; background-color: #f8f9fa;">
                    <!-- show any error or summary messages from session -->
                    <t t-if="request.session.get('window_schedule_upload_error')">
                        <div class="alert alert-danger mb-2" role="alert">
                            <t t-esc="request.session.pop('window_schedule_upload_error')"/>
                        </div>
                    </t>
                    
                    <t t-if="request.session.get('window_schedule_upload_summary')">
                        <t t-set="summary" t-value="request.session.pop('window_schedule_upload_summary')"/>
                        <div class="alert alert-info mb-2" role="alert">
                            <strong>Import Summary:</strong>
                            <t t-esc="summary.get('success_count', 0)"/> line(s) added successfully.
                            <t t-if="summary.get('failure_messages')">
                                <br/>
                                <strong>Issues:</strong>
                                <ul class="mb-0">
                                    <li t-foreach="summary.get('failure_messages')" t-as="msg">
                                        <t t-esc="msg"/>
                                    </li>
                                </ul>
                            </t>
                        </div>
                    </t>
                    
                    <form action="/shop/cart/upload_window_schedule"
                          method="post"
                          enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="form-group mb-2">
                            <label class="form-label">
                                Upload window schedule (.csv / .xlsx)
                            </label>
                            <input type="file"
                                   name="schedule_file"
                                   accept=".csv,.xlsx"
                                   class="form-control"
                                   required="required"/>
                            <small class="form-text text-muted">
                                Required columns: Width, Height, Qty. Optional: Label, System, Product Code, Unit, Color, Glass, Hardware
                            </small>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/shop/cart/window_schedule_template"
                               class="btn btn-link p-0">
                                <i class="fa fa-download"/> Download template
                            </a>
                            <button type="submit" class="btn btn-secondary">
                                <i class="fa fa-upload"/> Import to Cart
                            </button>
                        </div>
                    </form>
                </div>
            </t>
        </t>
    </template>
</odoo>
